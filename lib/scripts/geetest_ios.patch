diff --git a/lib/pages/login/geetest/geetest_plugin.dart b/lib/pages/login/geetest/geetest_plugin.dart
new file mode 100644
--- /dev/null
+++ b/lib/pages/login/geetest/geetest_plugin.dart
@@ -0,0 +1,41 @@
+import 'dart:async' show Completer;
+
+import 'package:PiliPlus/pages/login/geetest/login_challenge.dart';
+import 'package:gt3_flutter_plugin/gt3_flutter_plugin.dart';
+
+abstract final class GeetestPlugin {
+  static Future<Map<String, dynamic>?> geetest(String gt, String challenge) {
+    final result = Completer<Map<String, dynamic>?>();
+    final plugin = Gt3FlutterPlugin();
+    plugin.addEventHandler(
+      onShow: (_) {},
+      onClose: (_) {
+        if (!result.isCompleted) result.complete(null);
+      },
+      onResult: (event) {
+        // Code 0 leaves the SDK challenge open for another attempt.
+        if (result.isCompleted || event['code'].toString() != '1') return;
+        final proof = event['result'];
+        if (proof is Map) {
+          result.complete(Map<String, dynamic>.from(proof));
+        } else {
+          result.completeError(const GeetestFailure());
+        }
+      },
+      onError: (event) {
+        if (result.isCompleted) return;
+        if (event['code'].toString() == '-999') {
+          result.complete(null);
+        } else {
+          result.completeError(
+            GeetestFailure.provider(event['code'], event['description']),
+          );
+        }
+      },
+    );
+    plugin.startCaptcha(
+      Gt3RegisterData(gt: gt, challenge: challenge, success: true),
+    );
+    return result.future;
+  }
+}
